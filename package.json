{
  "name": "perfin",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "tsbuild": "tsc -p tsconfig.app.json",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "cftypes": "wrangler types server/cloudflare.d.ts && prettier -w server/cloudflare.d.ts",
    "migration:generate": "drizzle-kit generate",
    "migration:create": "wrangler d1 migrations create perfin-staging $(pnpm dlx human-id a l 0 _)",
    "migration:apply": "wrangler d1 migrations apply perfin-staging --local",
    "migration:apply-staging": "wrangler d1 migrations apply perfin-staging --remote",
    "runsql": "wrangler d1 execute perfin-staging --local --command",
    "runsqlfile": "wrangler d1 execute perfin-staging --local --file",
    "deploy:staging": "wrangler --env staging d1 migrations apply perfin-staging --remote & wrangler --env staging deploy --keep-vars",
    "deploy:production": "wrangler --env production d1 migrations apply perfin --remote & wrangler --env production deploy --keep-vars"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@headlessui/react": "^2.2.10",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@types/node": "^26.6.4",
    "@vis.gl/react-google-maps": "^1.10.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-beta.4-4605abe",
    "itty-router": "^5.0.24",
    "lucide-react": "^1.54.0",
    "magic-bytes.js": "^1.13.1",
    "nanoid": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.5",
    "zod-form-data": "^3.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "daisyui": "^5.7.47",
    "drizzle-kit": "1.0.0-beta.4-4605abe",
    "esbuild": "^0.28.2",
    "globals": "^17.13.0",
    "nanoid": "^5.1.5",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "zocker": "^3.0.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
